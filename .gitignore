# ============================================================
# Top-level .gitignore for the nikon project
# ============================================================

# Camera firmware binaries (copyrighted, large, not for git)
*.bin
*.BIN
extracted/
resources/
hidden/
analysis/notes/*.tmp

# Common across all sub-projects
__pycache__/
*.py[cod]
*$py.class
*.so
*.o
*.obj
build/
dist/
*.egg-info/

# Virtual envs
venv/
.venv/
env/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs and runtime
*.log
*.pid
*.sock

# Secrets
.env
*.local.yaml
*.local.yml
secrets/
